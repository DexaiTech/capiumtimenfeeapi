# The Capium Time & Fees background worker as its own image (emails, invoice emails with PDF,
# partitions, retention). Same code and dependencies as the API; only the command differs.
# Equivalent to `docker build --target worker .` with the main Dockerfile.
FROM python:3.14-slim
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1
WORKDIR /srv/app

# tzdata comes from requirements.txt, so zoneinfo works without the OS package.
COPY requirements.txt .
RUN pip install -r requirements.txt

COPY alembic.ini .
COPY alembic ./alembic
COPY app ./app

RUN useradd --system --uid 10001 --no-create-home app
USER app

CMD ["python", "-m", "app.workers.main"]
