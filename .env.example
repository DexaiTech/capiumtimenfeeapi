# Capium Time & Fees API settings. Copy to .env and fill in. Never commit .env, and never put
# real credentials in this file.

APP_ENV=development
APP_DEBUG=true

# PostgreSQL. Any postgres:// or postgresql:// URL works; it is converted for asyncpg.
# Hosted databases usually need ?sslmode=require. Local Docker: see docker-compose.yml.
DB_URL=postgresql://<user>:<password>@localhost:5432/<database>
# Optional direct (non-pooled) URL, used by migrations. Defaults to DB_URL.
# DB_DIRECT_URL=
# DB_POOL_SIZE=10
# DB_MAX_OVERFLOW=5
# Pre-ping costs one round trip per request; off by default. Connections are recycled
# after DB_POOL_RECYCLE_SECONDS instead (keep it below any idle timeout of the server
# or a proxy in between). Run the API close to the database: every request makes several
# round trips, so a distant database (for example 250 ms away) makes each page slow.
# DB_POOL_PRE_PING=false
# DB_POOL_RECYCLE_SECONDS=1800

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=<random string of at least 32 characters>
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000
# Comma-separated. Defaults to FRONTEND_URL.
CORS_ORIGINS=http://localhost:5173

# SMTP. For local development point this at Mailpit (docker compose up -d mailpit).
# Port 465 uses implicit TLS; other ports upgrade with STARTTLS when offered.
# SMTP_USER and SMTP_PASSWORD are required when APP_ENV=production.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=no-reply@example.com
SMTP_FROM_NAME=Capium Time & Fees

# Messaging gateway: `smtp` sends email through SMTP_HOST, `mock` records every message in the
# message_log table instead of sending it. Unset: smtp when SMTP_HOST is set, else mock. SMS is
# always the mock (there is no SMS provider).
# MESSAGING_BACKEND=smtp

# Central client service (the Capium group's master list of clients). `mock` is the only gateway
# so far: an in-memory catalogue of 25 UK companies and sole traders that can be switched off
# (POST /central-clients/mock/availability) and fed rename/archive/restore/merge events
# (POST /central-clients/mock/changes), for development and demonstrations. Its state lives in
# the API process; its switches answer 404 when APP_ENV=production. Default: mock.
# CENTRAL_CLIENT_GATEWAY=mock

# The other integrations, each behind its own interface (docs/modules/integrations.md). `mock` is the
# only implementation so far: in-memory, per API process, for development and demonstrations. Their
# development switches (outage, change feeds, the subscription status) answer 404 when
# APP_ENV=production. Default: mock for all four.
#   CENTRAL_USER_GATEWAY        the Capium central user directory (renamed, deactivated, reactivated)
#   PRACTICE_MANAGEMENT_GATEWAY practice management jobs and tasks (Phase 2A)
#   BOOKKEEPING_GATEWAY         issued invoices and credit notes sent to bookkeeping (Phase 2B)
#   SUBSCRIPTION_GATEWAY        the practice's subscription: every practice route answers 403
#                               SUBSCRIPTION_UNAVAILABLE while it is not active
# CENTRAL_USER_GATEWAY=mock
# PRACTICE_MANAGEMENT_GATEWAY=mock
# BOOKKEEPING_GATEWAY=mock
# SUBSCRIPTION_GATEWAY=mock
# How long (seconds, 1 to 3600) a practice's subscription status is trusted before it is asked for
# again. When the subscription service cannot be asked the last known status is kept.
# SUBSCRIPTION_CACHE_SECONDS=60

# Closed deployment: one practice and no public sign-up. When true (the default),
# POST /auth/register and POST /organizations answer 403 and an administrator creates staff
# accounts (POST /organizations/{id}/people, temporary password changed at first sign-in).
# Create the practice and its Owner once, after `alembic upgrade head`, with:
#   python -m app.maintenance.bootstrap --practice-name "..." --admin-name "..." --admin-email ...
# Set to false for multi-practice SaaS, where anyone may register and create a practice.
CLOSED_DEPLOYMENT=true

# Global request ceiling and body cap (defaults shown).
# API_RATE_LIMIT_ENABLED=true
# API_RATE_LIMIT_USER_PER_MINUTE=600
# API_RATE_LIMIT_IP_PER_MINUTE=120
# MAX_REQUEST_BODY_KB=1024
# Multiplies the sign-in and registration limits for scratch stacks only (must be 1 in production).
# AUTH_RATE_LIMIT_FACTOR=1

# Where uploaded files (ticket attachments) are kept. Unset: a `storage` directory next to `app/`
# (git-ignored); a relative path is resolved against the project root. In Docker the image sets
# /var/lib/capium/storage: mount a persistent volume there and back it up with the database.
# STORAGE_DIR=

# Background worker.
# WORKER_CONCURRENCY=5
# WORKER_POLL_INTERVAL_SECONDS=2.0
# WORKER_LEASE_SECONDS=300
